{
  "manifest_version": 3,
  "name": "Dịch Thuật Cafe",
  "version": "2.0.0",
  "description": "Dịch các thuật ngữ Cafe",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dịch Thuật Cafe"
  },
  "key": ""
}
